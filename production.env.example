# Copy to a protected environment file and replace every placeholder.
# Never commit the populated file or pass secrets as image build arguments.
NISCHIT_IMAGE_PREFIX=ghcr.io/OWNER/nischit
NISCHIT_VERSION=sha-REVIEWED_COMMIT
APP_DOMAIN=nischit.example.com
RAUTHY_DOMAIN=identity.example.com
RAUTHY_TRUSTED_PROXIES=REPLACE_WITH_REVERSE_PROXY_CIDR
RAUTHY_NODE_ID=1
RAUTHY_NODES=1 localhost:8100 localhost:8200
RAUTHY_SECRET_RAFT=REPLACE_WITH_LONG_RANDOM_SECRET
RAUTHY_SECRET_API=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET

POSTGRES_DB=nischit
POSTGRES_USER=nischit_owner
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
MIGRATION_DATABASE_URL=postgres://nischit_owner:REPLACE_WITH_URL_ESCAPED_SECRET@postgres:5432/nischit
DATABASE_URL=postgres://nischit_app:REPLACE_WITH_URL_ESCAPED_SECRET@postgres:5432/nischit
VALKEY_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
VALKEY_URL=redis://:REPLACE_WITH_URL_ESCAPED_SECRET@valkey:6379

IDENTITY_MODE=rauthy-session
RAUTHY_ISSUER=https://identity.example.com/auth/v1
RAUTHY_CLIENT_ID=nischit-web
RAUTHY_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
NISCHIT_OIDC_REDIRECT_URI=https://nischit.example.com/auth/callback
AUTH_SESSION_ISSUER=nischit-session
AUTH_SESSION_COOKIE=nischit_session
AUTH_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
IDENTITY_AUDIENCE=nischit-api
IDENTITY_TENANT_CLAIM=tenant_id
IDENTITY_DEFAULT_TENANT_ID=
IDENTITY_USER_CLAIM=sub
IDENTITY_BOOTSTRAP_EMAIL=
IDENTITY_BOOTSTRAP_TENANT_ID=
IDENTITY_BOOTSTRAP_TENANT_NAME=
IDENTITY_BOOTSTRAP_ROLES=owner,admin

R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=nischit-private-evidence
R2_ACCESS_KEY=REPLACE_WITH_SCOPED_ACCESS_KEY
R2_SECRET_KEY=REPLACE_WITH_SCOPED_SECRET
EVIDENCE_SCANNER_HOST=REPLACE_WITH_PRIVATE_SCANNER_HOST
EVIDENCE_SCANNER_PORT=3310
EVIDENCE_SCANNER_TIMEOUT_MS=30000
MAX_EVIDENCE_BYTES=10485760

# Live rails require separate security, legal, custody, and reconciliation review.
# Configure only after that review and use an isolated network during verification.
PAYMENT_MODE=tempo
ATTESTATION_MODE=solana
TEMPO_RPC_URL=REPLACE_WITH_APPROVED_RPC_ENDPOINT
TEMPO_CHAIN_ID=42431
TEMPO_ESCROW_ADDRESS=REPLACE_WITH_REVIEWED_CONTRACT_ADDRESS
TEMPO_PAYER_PRIVATE_KEY=REPLACE_WITH_RESTRICTED_SIGNER_KEY
TEMPO_TOKEN_ADDRESSES_JSON='{"TEST_USD":"REPLACE_WITH_TOKEN_ADDRESS"}'
TEMPO_SUPPLIER_ADDRESSES_JSON='{"supplier-tenant":"REPLACE_WITH_ADDRESS"}'
TEMPO_CONFIRMATIONS=1
SOLANA_RPC_URL=REPLACE_WITH_APPROVED_RPC_ENDPOINT
SOLANA_RPC_SUBSCRIPTIONS_URL=REPLACE_WITH_APPROVED_WEBSOCKET_ENDPOINT
SOLANA_SIGNER_SECRET_KEY=REPLACE_WITH_RESTRICTED_SIGNER_SECRET
SOLANA_MEMO_PREFIX=nischit:v1
