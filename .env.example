NODE_ENV=development
PORT=4000
PERSISTENCE_MODE=memory
DATABASE_URL=postgres://nischit:nischit_local@localhost:5432/nischit
# Hosted API/worker DATABASE_URL must use the non-owner nischit_app role.
# Hosted migrations use a separate owner connection:
# MIGRATION_DATABASE_URL=postgres://nischit_owner:...@postgres:5432/nischit
VALKEY_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Explicitly select mocks for local development. Set both modes to real testnet
# adapters only after configuring every required signing/address variable below.
PAYMENT_MODE=mock
ATTESTATION_MODE=mock
# PAYMENT_MODE=tempo
# TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
# TEMPO_CHAIN_ID=42431
# TEMPO_ESCROW_ADDRESS=0x...
# TEMPO_PAYER_PRIVATE_KEY=0x...
# TEMPO_TOKEN_ADDRESSES_JSON='{"TEST_USD":"0x..."}'
# TEMPO_SUPPLIER_ADDRESSES_JSON='{"preview-supplier":"0x..."}'
# TEMPO_CONFIRMATIONS=1
# TEMPO_ESCROW_DEPLOYMENT_BLOCK=0
# ATTESTATION_MODE=solana
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_RPC_SUBSCRIPTIONS_URL=wss://api.devnet.solana.com
# SOLANA_NETWORK_NAME=Solana devnet
# SOLANA_SIGNER_SECRET_KEY=[...]
# SOLANA_MEMO_PREFIX=nischit:v1

# Optional verified OIDC/JWT mode. When all three values are present the API
# uses RS256 bearer tokens instead of local x-tenant-id/x-user-id preview
# headers. Use literal \\n
# escapes if the environment cannot contain newlines.
# IDENTITY_ISSUER=https://your-issuer.example/
# IDENTITY_AUDIENCE=nischit-api
# IDENTITY_TENANT_CLAIM=tenant_id
# IDENTITY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=nischit-local
OBJECT_STORE_ACCESS_KEY=replace-me
OBJECT_STORE_SECRET_KEY=replace-me
OBJECT_STORE_FORCE_PATH_STYLE=true
MAX_EVIDENCE_BYTES=10485760
# Private ClamAV TCP scanner required before hosted evidence uploads are enabled.
# EVIDENCE_SCANNER_HOST=clamav
# EVIDENCE_SCANNER_PORT=3310
# EVIDENCE_SCANNER_TIMEOUT_MS=30000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Local preview identity only; production should resolve identity from the configured auth provider.
NEXT_PUBLIC_NISCHIT_ROLE=buyer
NEXT_PUBLIC_NISCHIT_TENANT_ID=preview-buyer
NEXT_PUBLIC_NISCHIT_USER_ID=preview-buyer-owner
NEXT_PUBLIC_NISCHIT_USER_NAME=Procurement owner
NEXT_PUBLIC_NISCHIT_TENANT_NAME=Nischit Laboratory
